T_CMB_0 = CMB_TEMPERATURE
U_CMB_0_J_M3 = 4.17e-14  # a T^4 con T = 2.7255 K

PREFACTOR_BREMS = 4.0 * FINE_STRUCTURE_CONSTANT * ELECTRON_RADIUS_MKS**2


