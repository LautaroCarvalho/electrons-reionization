             populations give harder spectra, so $z\sim10$ should lie below 4.5}
}

@article{Aharonian2024,
  author  = {Aharonian, F. and {H.E.S.S. Collaboration}},
  title   = {Acceleration and transport of relativistic electrons in the jets of
             the microquasar {SS}~433},
  journal = {Science},
  volume  = {383},
  number  = {6681},
  pages   = {402--406},
  year    = {2024},
  doi     = {10.1126/science.adi2048},
  eprint  = {2401.16019},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2401.16019},
  note    = {IN TREE (added 2026-09-15). VERIFIED from the PDF. Injected
             electron spectrum parameterised as $dN/dE\propto
             E^{-\Gamma_e}\exp(-E/E_{\rm cut})$ --- EXACTLY this project's
             $\alpha_e$ convention. They fix $\Gamma_e=2$, justified because
             synchrotron from electrons of index $\Gamma_e$ gives a photon index
             $(\Gamma_e+1)/2$, and the measured X-ray photon index at both outer
             jet bases is $\simeq1.5$. $E_{\rm cut}>200$~TeV (68\% C.L.).
             DECISIVE for this project: ``the power required to reproduce the
             observed emission is around 0.13\% of the jet kinetic power of
             $10^{39}$ erg\,s$^{-1}$'', i.e. $L_e\simeq1.3\times10^{36}$
             erg\,s$^{-1}$ ABOVE 10 MeV. That leptonic fraction of
             $1.3\times10^{-3}$ sits at the very BOTTOM of the $10^{-3}$--$1$
             range this project scans, so the strongly-leptonic end of that scan
             --- where the AGN box crossed parity --- is not supported by the
             one direct measurement}
}
